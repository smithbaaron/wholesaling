# Keep the build context small and keep secrets and local state out of the image.
.git
.github
.venv
venv
.env
.env.*
!.env.example
*.db
*.db-journal
local.db
var/

# Tests, docs and the source documents are not needed at runtime.
tests/
docs/
*.docx
*.pdf
*.md
!README.md
HANDOFF.md
REQUIREMENTS.md

# Local tooling and caches.
.mypy_cache
.pytest_cache
.ruff_cache
__pycache__
*.py[cod]
.coverage
htmlcov/
build/
dist/
*.egg-info/
.vscode
.idea
.DS_Store
Thumbs.db
docker-compose.yml
Dockerfile
.dockerignore
.railway/
