# Copy to .env and fill in. Never commit .env. Every value here is read by wholesaling/config/settings.py.
# Each section corresponds to a human-action checkpoint in docs/CHECKPOINTS.md. Leave a section blank
# until that checkpoint is cleared; the matching integration then runs in MOCK mode.

# ---- Runtime ----------------------------------------------------------------
APP_ENV=local                      # local | test | staging | production
LOG_LEVEL=INFO
SERVICE_ROLE=api                   # api | worker  (Railway runs one container per role)
PORT=8000

# ---- Database (Checkpoint: Railway Postgres, or local Postgres) --------------
# Local default uses SQLite so the repo runs with no services. Production MUST be Postgres.
DATABASE_URL=sqlite+aiosqlite:///./local.db
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/wholesaling
# Optional: separate URL for the Postgres-backed test suite (tests marked "postgres" skip when unset)
TEST_DATABASE_URL=

# ---- Temporal (Checkpoint: Temporal Cloud account) --------------------------
# Local dev server: `temporal server start-dev` -> localhost:7233, namespace "default", no TLS.
TEMPORAL_MODE=mock                 # mock | live  (mock = in-memory client, no server needed)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=                  # Temporal Cloud API key (leave blank for local dev server)
TEMPORAL_TLS=false                 # true for Temporal Cloud
TEMPORAL_TLS_CLIENT_CERT_PATH=     # mTLS alternative to the API key: path to client cert PEM
TEMPORAL_TLS_CLIENT_KEY_PATH=      # path to the matching client private key PEM
TEMPORAL_TASK_QUEUE=wholesaling-main

# ---- Model provider (Checkpoint: model API key) -----------------------------
MODEL_PROVIDER=mock                # mock | anthropic | openai-compatible
ANTHROPIC_API_KEY=
MODEL_CLASSIFY=claude-haiku-5-5
MODEL_EXTRACT=claude-haiku-5-5
MODEL_DRAFT=claude-sonnet-5-5
MODEL_QA=claude-sonnet-5-5
MODEL_COMP_AUDIT=claude-sonnet-5-5

# ---- Microsoft Graph / Outlook (Checkpoint: M365 mailbox + Entra app) --------
GRAPH_MODE=mock                    # mock | live
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=                     # user principal name of the sending mailbox
GRAPH_WEBHOOK_URL=                 # public https URL of /webhooks/graph on Railway
GRAPH_WEBHOOK_CLIENT_STATE=        # random secret echoed by Graph notifications
GRAPH_ALLOW_LIVE_SEND=false        # RUL-06: live send_draft is refused unless true (drafts still work)

# ---- Data providers (Checkpoint: deed / signals / enrichment provider selected, INT-03) ----
DATA_PROVIDER_MODE=mock            # mock | live  (live refused until a provider is selected)
DISTRESS_PROVIDER_MODE=mock        # mock | live  (INT-04 OPEN; live refused)
SKIPTRACE_PROVIDER_MODE=mock       # mock | live  (INT-05 OPEN, PRE-11; live refused)

# ---- Google Sheets (Checkpoint: Google account + service account) -----------
SHEETS_MODE=mock                   # mock | live
GOOGLE_SERVICE_ACCOUNT_JSON=       # path to the service-account key file (not the key itself)
SHEETS_SPREADSHEET_ID=

# ---- Zapier parser (optional path; default OFF) -----------------------------
ZAPIER_PARSER_ENABLED=false
ZAPIER_PARSER_ADDRESS=

# ---- SMS (Checkpoint: Twilio + 10DLC). NEVER enabled in this build ----------
SMS_MODE=off                       # off | mock | live
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ---- DocuSign (Checkpoint: DocuSign account + attorney-reviewed templates) ---
DOCUSIGN_MODE=mock                 # mock | live
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_AUTH_HOST=account-d.docusign.com   # account-d (sandbox) | account.docusign.com (prod)
DOCUSIGN_PSA_TEMPLATE_ID=
DOCUSIGN_ASSIGNMENT_TEMPLATE_ID=
DOCUSIGN_CONNECT_HMAC_KEY=

# ---- Object storage for seller photos (Checkpoint: storage choice) ----------
BLOB_MODE=local                    # local | s3
BLOB_LOCAL_DIR=./var/blobs
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Sender identity for outbound mail (Checkpoint: PRE-02 address, PRE-16 approval) ------
# CAN-SPAM (CMP-01): every email carries the sender identity, a physical postal address and an
# opt-out line. Outreach drafts refuse to render until SENDER_POSTAL_ADDRESS is set.
SENDER_NAME=Aaron
SENDER_COMPANY=NorthStack
SENDER_POSTAL_ADDRESS=
OPT_OUT_TEXT=If you would rather not hear from us, reply with "unsubscribe" and we will remove you.

# ---- Business-hour send window, market local time (INV-12; Checkpoint: PRE-16) ------------
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=17
SEND_WINDOW_WEEKDAYS_ONLY=true

# ---- WF-02 sequence starter: investor sequences started per UTC day (config/caps.yaml
# outreach_kickoff_daily_cap overrides when set) --------------------------------------------
OUTREACH_KICKOFF_DAILY_CAP=50

# ---- Public seller web form (SEL-12, INT-26) -------------------------------------------
# PUBLIC_BASE_URL is the https origin of the API on Railway; S4 appends /sell?lead=<id> for the
# photo-upload link. The form is unauthenticated and rate-limited per client IP in process.
PUBLIC_BASE_URL=http://localhost:8000
SELL_FORM_RATE_LIMIT_PER_MINUTE=10
SELL_FORM_MAX_PHOTOS=10
SELL_FORM_MAX_PHOTO_BYTES=10485760

# ---- Alerting ----------------------------------------------------------------
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=

# ---- Budget -------------------------------------------------------------------
SOFT_BUDGET_CAP_USD=1500
SOFT_BUDGET_ALERT_PCT=80

# ---- Operator surface: review queue, policy page, daily digest (BO-07) -------
# Single operator, HTTP Basic on /review and /policies. Generate the hash with:
#   uv run python -c "from wholesaling.api.auth import hash_password; print(hash_password('your-password'))"
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
DIGEST_HOUR_LOCAL=7                # local hour the daily digest is sent (0-23)
OPERATOR_TIMEZONE=America/Chicago  # IANA zone for the digest schedule and "day" boundaries
