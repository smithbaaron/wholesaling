{
  "_meta": {
    "format": "unified",
    "version": 1,
    "purpose": "A5 QA golden set (REQUIREMENTS.md INV-17, INV-22, XC-07, POL-03c). Each case is a draft plus its context; expected carries the verdict, the flags and whether the model was reached. Pre-check cases (prohibited claims, opt-out, wrong recipient, repeated ask, cadence) must block without a model call; model-path cases use `model_flags` to script what the model adds in scripted mode and `flags` / `flags_include` for the final flag set.",
    "input": {
      "draft": "{to, subject, body, asks_for, contains_sensitive}",
      "thread": "[{direction in|out, body, hours_ago?, from?}]",
      "facts": "object",
      "current_buy_box": "object|null",
      "thread_participant": "email|null",
      "recipient_suppressed": "bool",
      "last_outbound_asks_for": "[field]",
      "last_outbound_hours_ago": "number|null",
      "scheduled_sequence": "bool"
    },
    "expected": {
      "verdict": "approve|block|rewrite",
      "flags": "exact final flag set",
      "flags_include": "required subset (optional)",
      "model_called": "bool",
      "model_flags": "flags the scripted model returns",
      "min_confidence": "optional",
      "has_rewrite_body": "optional",
      "rewrite_body": "scripted rewrite (optional)",
      "rewrite_body_excludes": "optional"
    }
  },
